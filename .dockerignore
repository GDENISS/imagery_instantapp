# Keep the build context small and reproducible.
#
# NOTE: .env.production is deliberately NOT ignored. Webpack inlines its values at build time, so the
# Docker build needs it in the context. It holds an ArcGIS app id and service URLs, which are public
# by design (they ship inside the JavaScript bundle either way) - but it is still not committed to git.

node_modules
dist
coverage

.git
.github
.vscode
.idea

e2e
**/*.test.ts
**/*.test.tsx

# other apps' env files - only the one passed as ENV_FILE is needed
.env
.env.development

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-lock.yaml

Thumbs.db
.DS_Store
